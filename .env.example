# Copy to .env and fill in. Every value here is public by design: Vite inlines
# VITE_-prefixed variables into the client bundle, so they are readable by
# anyone who loads the app.
#
# Never add a server-side secret to this file. Service role keys and third-party
# API credentials go in Supabase -> Edge Functions -> Secrets, where the edge
# functions read them via Deno.env.get().

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""
